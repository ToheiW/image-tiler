{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "image_tiler",
  "version": "0.1.0",
  "identifier": "com.scottjenkins.imagetiler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Image Tiler",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$PICTURE/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$DOCUMENT/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["png"],
        "name": "PNG image",
        "description": "PNG image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/png",
        "contentTypes": ["public.png"]
      },
      {
        "ext": ["jpg", "jpeg"],
        "name": "JPEG image",
        "description": "JPEG image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/jpeg",
        "contentTypes": ["public.jpeg"]
      },
      {
        "ext": ["webp"],
        "name": "WebP image",
        "description": "WebP image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/webp",
        "contentTypes": ["public.image"]
      }
    ]
  }
}
